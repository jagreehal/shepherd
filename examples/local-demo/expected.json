{
  "about": "Planted bugs for `shepherd local demo`. Lines are on the planted side; `match` holds the patterns a finding must name for `shepherd eval` to credit it. Each bug reaches the change a different way: an unpushed commit, a staged edit, an unstaged edit, an untracked file, and a deletion.",
  "bugs": [
    { "id": "hardcoded-key", "class": "credential in source", "file": "src/config.ts", "lines": [2, 2], "enters_as": "unstaged edit", "match": ["(hard.?coded|committed|in (the )?source|literal|leak)[^.]{0,40}(key|secret|credential)", "(key|secret|credential)[^.]{0,40}(hard.?coded|committed|in (the )?source|source control|leak)", "sk_live"] },
    { "id": "page-offset", "class": "off-by-one: pages start at 1", "file": "src/users.ts", "lines": [5, 5], "enters_as": "unpushed commit", "match": ["off.by.one", "offset[^.]{0,40}(page|skip)", "(first|1st) page", "pages? (start|are numbered|is) [^.]{0,20}(1|one)"] },
    { "id": "unawaited-write", "class": "write not awaited, so its failure is lost", "file": "src/notes.ts", "lines": [7, 7], "enters_as": "staged edit", "match": ["not awaited", "missing await", "unawaited", "without (an )?await", "no await", "floating promise"] },
    { "id": "swallowed-error", "class": "empty catch, and saveNote reports success anyway", "file": "src/notes.ts", "lines": [8, 10], "enters_as": "staged edit", "match": ["swallow", "empty catch", "catch[^.]{0,40}(ignor|discard|empty|nothing)", "reports success"] },
    { "id": "removed-authz", "class": "admin check deleted from deleteNote", "file": "src/notes.ts", "lines": [13, 14], "enters_as": "staged deletion", "match": ["admin check", "authori[sz]ation", "permission check", "any (user|caller|one) (can|may) delete", "access control"] },
    { "id": "ts-ignore", "class": "suppression hides a string assigned to a number", "file": "src/search.ts", "lines": [4, 5], "enters_as": "untracked file", "match": ["ts-ignore[^.]{0,80}(hid|mask|silenc|suppress|string|number|type error)", "suppress[^.]{0,40}(type|error)"] },
    { "id": "sql-injection", "class": "user input interpolated into SQL", "file": "src/search.ts", "lines": [7, 7], "enters_as": "untracked file", "match": ["sql injection", "inject", "interpolat[^.]{0,40}(sql|query)", "parameteri[sz]ed"] }
  ]
}
