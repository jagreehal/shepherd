{
  "name": "@jagreehal/shepherd",
  "version": "0.18.0",
  "description": "Agent skills that drive a PR to merge-ready: a review swarm, thread triage, CI repair, and a loop that hands the result to the gate.",
  "license": "MIT",
  "repository": "github:jagreehal/shepherd",
  "type": "module",
  "bin": {
    "shepherd": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "skills",
    "commands",
    "examples",
    "lenses",
    "packs",
    "templates",
    "schema",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md",
    "gate/src",
    "!gate/src/*.test.ts",
    "gate/.shepherd",
    "gate/templates"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "oxlint src gate/src",
    "changeset": "changeset",
    "version-packages": "changeset version && bun tools/sync-gate-version.ts",
    "release": "changeset publish",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run docs:check && bun run --cwd docs build && bun docs/scripts/check-built.ts",
    "docs:check": "bun docs/scripts/check.ts",
    "docs:preview": "bun run --cwd docs preview",
    "schema": "bun src/cli.ts config schema > schema/config.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "ajv": "8.20.0",
    "executable-stories-bun": "^0.1.0",
    "executable-stories-formatters": "^1.27.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.118",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/groq": "4.0.63",
    "@ai-sdk/mistral": "4.0.66",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "ai": "7.0.143",
    "autotel": "9.3.0",
    "autotel-bedrock": "4.0.0",
    "autotel-genai": "0.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
