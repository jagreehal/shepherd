{
  "name": "@jagreehal/shepherd",
  "version": "0.4.0",
  "description": "Agent skills that drive a PR to merge-ready: a review swarm, thread triage, CI repair, and a loop that hands the result to stamp.",
  "license": "MIT",
  "repository": "github:jagreehal/shepherd",
  "type": "module",
  "bin": {
    "shepherd": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "skills",
    "commands",
    "examples",
    "lenses",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "oxlint src",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "executable-stories-bun": "^0.1.0",
    "executable-stories-formatters": "^1.27.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "autotel": "8.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
