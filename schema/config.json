{
  "title": "shepherd team policy (.shepherd/config.yml)",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tiers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ladder": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "lenses": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "enum": [
              "refuse",
              "escalate",
              "note"
            ]
          },
          "only": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disable": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    "fixes": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "suggest",
            "local",
            "push"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "escalate": {
      "type": "object",
      "properties": {
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "format": "uri",
          "pattern": "^https://(?:[A-Za-z0-9-]+\\.)*[A-Za-z][A-Za-z0-9-]*(?::(?:6553[0-5]|655[0-2]\\d|65[0-4]\\d{2}|6[0-4]\\d{3}|[1-5]\\d{4}|\\d{1,4}))?(?:[/?#]\\S*)?$"
        },
        "emoji": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "high": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "medium": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "low": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "nit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "blocked": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "changes_needed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "approve_with_nits": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "looks_good": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            },
            "resolved": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[^\\s<>&*_`[\\]\\\\|]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\n\\r]*$"
        },
        "aws_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\n\\r]*$"
        },
        "notify_on": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "pending",
              "error"
            ]
          }
        },
        "max_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "push_deny": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\n\\r]*$"
          }
        },
        "incident_paths": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\n\\r]*$"
        },
        "audit": {
          "type": "object",
          "properties": {
            "plays": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              }
            },
            "public": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "swarm",
                "triage",
                "simplify",
                "ci-repair",
                "stamp",
                "incident"
              ]
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
